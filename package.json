{
  "name": "pictonary",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time multiplayer Pictionary for family & friends — teams or free-for-all.",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node scripts/smoke.js",
    "cf:dev": "vite build && wrangler dev",
    "cf:deploy": "vite build && wrangler deploy",
    "words": "node scripts/build-words.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@neondatabase/serverless": "^1.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "svelte": "^5.57.2",
    "vite": "^8.3.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "naughty-words": "^1.2.0",
    "wordlist-english": "^1.2.1",
    "wordnet-db": "^3.1.14",
    "wrangler": "4.86.0"
  }
}
